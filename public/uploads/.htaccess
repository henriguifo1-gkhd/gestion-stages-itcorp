# Les fichiers déposés ne sont jamais servis directement par le serveur web :
# ils sont téléchargés uniquement via l'application (contrôle d'accès par rôle).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
